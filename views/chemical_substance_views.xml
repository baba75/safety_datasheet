    <!-- form views -->
    <record id="chemical_classification_view_form" model="ir.ui.view">
        <field name="name">sds.chemical.classification.view.form</field>
        <field name="model">sds.chemical.classification</field>
        <field name="arch" type="xml">
            <form string="EU Classification">
                <sheet>
                    <group>
                        <field name="HazardCategories" />
                        <field name="HazardStatement" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="chemical_substances_view_form" model="ir.ui.view">
        <field name="name">sds.chemical.substance.view.form</field>
        <field name="model">sds.chemical.substance</field>
        <field name="arch" type="xml">
            <form string="Chemical Substances">
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="IUPACname" />
                    </group>
                    <group>
                        <field name="CASno" />
                        <field name="ECno" />
                        <field name="REACHno" />
                    </group>
                    <group>
                        <field name="Classification" widget="one2many_list">
                            <tree string="EU Classification" editable="bottom">
                                <field name="HazardCategories" />
                                <field name="HazardStatement" context="{'show_only_code': True}" />
                            </tree>
                        </field>
                    </group>
                    <group>
                        <field name="last_update" />
                        <field name="wrk_exp_limit" />
                    </group>
                    <group attrs="{'invisible': [('wrk_exp_limit', '=', False)]}">
                        <field name="wrk_exp_tlv" widget="html" />
                    </group>
                    <group>
                        <field name="pnec" />
                    </group>
                    <group attrs="{'invisible': [('pnec', '=', False)]}">
                        <group name="pnec_group" string="Predicted No Effect Concentration (PNEC)">
                            <group name="pnec_aquatic" string="Hazard for Aquatic Organisms" colspan="2">
                                <field name="freshwater" />
                                <field name="int_rel_fw" />
                                <field name="marinew" />
                                <field name="int_rel_mw" />
                                <field name="stp" />
                                <field name="sediment_fw" />
                                <field name="sediment_mw" />
                            </group>
                            <group name="pnec_air" string="Hazard for Air" colspan="2">
                                <field name="air" />
                            </group>
                            <group name="pnec_soil" string="Hazard for Terrestrial Organism" colspan="2">
                                <field name="soil" />
                            </group>
                            <group name="pnec_predators" string="Hazard for Predators" colspan="2">
                                <field name="sec_poisoning" />
                            </group>
                        </group>
                    </group>
                    <group>
                        <field name="dnel" />
                    </group>
                    <group attrs="{'invisible': [('dnel', '=', False)]}">
                        <group name="dnel_workers" string="Data for workers">
                            <group name="dnel_inhalation_workers" string="Inhalation Exposure" colspan="2">
                                <field name="wrk_ln_sys_inhalation" />
                                <field name="wrk_aq_sys_inhalation" />
                                <field name="wrk_ln_lcl_inhalation" />
                                <field name="wrk_aq_lcl_inhalation" />
                            </group>
                            <group name="dnel_dermal_workers" string="Dermal Exposure" colspan="2">
                                <field name="wrk_ln_sys_dermal" />
                                <field name="wrk_aq_sys_dermal" />
                                <field name="wrk_ln_lcl_dermal" />
                                <field name="wrk_aq_lcl_dermal" />
                            </group>
                            <group name="dnel_eye_workers" string="Eye Exposure" colspan="2">
                                <field name="wrk_eye" />
                            </group>
                        </group>
                        <group name="dnel_population" string="Data for the general population">
                            <group name="dnel_inhalation_population" string="Inhalation Exposure" colspan="2">
                                <field name="pop_ln_sys_inhalation" />
                                <field name="pop_aq_sys_inhalation" />
                                <field name="pop_ln_lcl_inhalation" />
                                <field name="pop_aq_lcl_inhalation" />
                            </group>
                            <group name="dnel_dermal_population" string="Dermal Exposure" colspan="2">
                                <field name="pop_ln_sys_dermal" />
                                <field name="pop_aq_sys_dermal" />
                                <field name="pop_ln_lcl_dermal" />
                                <field name="pop_aq_lcl_dermal" />
                            </group>
                            <group name="dnel_oral_population" string="Oral Exposure" colspan="2">
                                <field name="pop_ln_sys_oral" />
                                <field name="pop_aq_sys_oral" />
                            </group>
                            <group name="dnel_eye_population" string="Eye Exposure" colspan="2">
                                <field name="pop_eye" />
                            </group>
                        </group>
                    </group>
                    <group>
                        <field name="reactivity" widget="many2many">
                            <tree editable="bottom">
                                <field name="sequence" widget="handle" />
                                <field name="name" />
                            </tree>
                        </field>
                    </group>
                    <group>
                        <field name="toxicological" />
                    </group>
                    <group name="Toxicological information" attrs="{'invisible': [('toxicological', '=', False)]}">
                        <field name="acute_summary" type="html" options="{'codeview': True}"/>
                        <field name="skin_corrosion" type="html" options="{'codeview': True}"/>
                        <field name="eye_damage" type="html" options="{'codeview': True}"/>
                        <field name="sensitization" type="html" options="{'codeview': True}"/>
                        <field name="mutagenity" type="html" options="{'codeview': True}"/>
                        <field name="carcinogenicity" type="html" options="{'codeview': True}"/>
                        <field name="reproductive_toxicity" type="html" options="{'codeview': True}"/>
                        <field name="stot_se" type="html" options="{'codeview': True}"/>
                        <field name="stot_re" type="html" options="{'codeview': True}"/>
                        <field name="aspiration_hazard" type="html" options="{'codeview': True}"/>
                    </group>
                    <group>
                        <field name="ecological" />
                    </group>
                    <group name="Ecological information" attrs="{'invisible': [('ecological', '=', False)]}">
                        <field name="toxicity_detail" type="html" options="{'codeview': True}"/>
                        <field name="degradability" type="html" options="{'codeview': True}"/>
                        <field name="bioaccumulation" type="html" options="{'codeview': True}"/>
                        <field name="mobility" type="html" options="{'codeview': True}"/>
                        <field name="pbt_vPvB" type="html" options="{'codeview': True}"/>
                        <field name="endocrine" type="html" options="{'codeview': True}"/>
                        <field name="other_effects" type="html" options="{'codeview': True}"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_chemical_classification_form" model="ir.ui.view">
        <field name="name">sds.chemical.classification.view.form</field>
        <field name="model">sds.chemical.classification</field>
        <field name="arch" type="xml">
            <tree string="EU Classification">
                <field name="HazardCategories" />
                <field name="HazardStatement" />
            </tree>
        </field>
    </record>

    <!-- search views -->
    <record id="view_substances_search" model="ir.ui.view">
        <field name="name">sds.chemical.substance.search</field>
        <field name="model">sds.chemical.substance</field>
        <field name="arch" type="xml">
            <search string="Substance">
                <field name="name" string="Substance name" />
                <field name="ECno" string="EC Number" />
                <field name="CASno" string="CAS Number" />
            </search>
        </field>

    </record>

    <!-- actions opening views on models -->
    <record id="action_chemical_substances" model="ir.actions.act_window">
        <field name="name">Chemical Substances</field>
        <field name="res_model">sds.chemical.substance</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                    Create a new Chemical Substance
            </p>
        </field>
    </record>

    <!-- tree views -->
    <record id="view_chemical_classification_tree" model="ir.ui.view">
        <field name="name">sds.chemical.classification.tree</field>
        <field name="model">sds.chemical.classification</field>
        <field name="arch" type="xml">
            <tree string="EU Classification">
                <field name="HazardCategories" />
                <field name="HazardStatement" />
            </tree>
        </field>
    </record>

    <record id="view_substances_tree" model="ir.ui.view">
        <field name="name">sds.chemical.substance.tree</field>
        <field name="model">sds.chemical.substance</field>
        <field name="arch" type="xml">
            <tree string="Chemical Substances">
                <field name="name" />
                <field name="ECno" />
                <field name="CASno" />
            </tree>
        </field>
    </record>

</odoo>