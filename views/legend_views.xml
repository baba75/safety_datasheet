    <!-- form views -->
    <record id="legend_view_form" model="ir.ui.view">
        <field name="name">sds.legend.view.form</field>
        <field name="model">sds.legend</field>
        <field name="arch" type="xml">
            <form string="Legend">
                <sheet>
                    <group>
                        <field name="acronym" />
                        <field name="description" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- search views -->

    <!-- actions opening views on models -->
    <record id="action_legend" model="ir.actions.act_window">
        <field name="name">Legend</field>
        <field name="res_model">sds.legend</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                    Create a new Legend entry, e.g. SDS = Safety Data Sheet
            </p>
        </field>
    </record>

    <!-- tree views -->
    <record id="view_legend_tree" model="ir.ui.view">
        <field name="name">sds.legend.tree</field>
        <field name="model">sds.legend</field>
        <field name="arch" type="xml">
            <tree string="Legend">
                <field name="acronym" />
                <field name="description" />
            </tree>
        </field>
    </record>

</odoo>