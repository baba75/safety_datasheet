    <!-- form views -->
    <record id="bibliography_view_form" model="ir.ui.view">
        <field name="name">sds.bibliography.view.form</field>
        <field name="model">sds.bibliography</field>
        <field name="arch" type="xml">
            <form string="Bibliography">
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="url" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- search views -->

    <!-- actions opening views on models -->
    <record id="action_bibliography" model="ir.actions.act_window">
        <field name="name">Bibliography</field>
        <field name="res_model">sds.bibliography</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                    Create a new Bibliography entry
            </p>
        </field>
    </record>

    <!-- tree views -->
    <record id="view_bibliography_tree" model="ir.ui.view">
        <field name="name">sds.bibliography.tree</field>
        <field name="model">sds.bibliography</field>
        <field name="arch" type="xml">
            <tree string="Bibliography">
                <field name="name" />
                <field name="url" />
            </tree>
        </field>
    </record>

</odoo>