    <!-- form views -->
    <record id="distributor_view_form" model="ir.ui.view">
        <field name="name">sds.distributor.view.form</field>
        <field name="model">sds.distributor</field>
        <field name="arch" type="xml">
            <form string="National Distributor">
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="country" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- search views -->

    <!-- actions opening views on models -->
    <record id="action_distributor" model="ir.actions.act_window">
        <field name="name">National Distributors</field>
        <field name="res_model">sds.distributor</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                    Create a new National Distributor entry
            </p>
        </field>
    </record>

    <!-- tree views -->
    <record id="view_distributor_tree" model="ir.ui.view">
        <field name="name">sds.distributor.tree</field>
        <field name="model">sds.distributor</field>
        <field name="arch" type="xml">
            <tree string="National Distributor">
                <field name="name" />
                <field name="country" />
            </tree>
        </field>
    </record>

</odoo>