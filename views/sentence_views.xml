    <!-- form views -->
    <record id="action_sentence_view_form" model="ir.ui.view">
        <field name="name">sds.sentences.view.form</field>
        <field name="model">sds.sentences</field>
        <field name="arch" type="xml">
            <form string="Action sentences">
                <sheet>
                    <group>
                        <field name="sequence" attrs="{'invisible': True}" />
                        <field name="category" />
                        <field name="name" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- search views -->

    <record id="sds_sentences_view_search" model="ir.ui.view">
        <field name="name">sds.sentences.search</field>
        <field name="model">sds.sentences</field>
        <field name="arch" type="xml">
            <search string="Sentences">
                <field name="name" string="Sentence" />
                <field name="category" string="Category" />
            </search>
        </field>
    </record>

    <!-- actions opening views on models -->
    <record id="action_action_sentences" model="ir.actions.act_window">
        <field name="name">Action Sentences</field>
        <field name="res_model">sds.sentences</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                    Create a new Action Sentence, e.g. First Aid Action Sentence
            </p>
        </field>
    </record>

    <!-- tree views -->
    <record id="view_action_sentences_tree" model="ir.ui.view">
        <field name="name">sds.sentences.tree</field>
        <field name="model">sds.sentences</field>
        <field name="arch" type="xml">
            <tree string="Action Sentences">
                <field name="name" />
                <field name="category" />
            </tree>
        </field>
    </record>

</odoo>