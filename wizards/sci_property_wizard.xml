<odoo>
    <record id="wizard_dnel" model="ir.ui.view">
        <field name="name">DNEL</field>
        <field name="model">sci.property.dnel.wizard</field>
        <field name="arch" type="xml">
            <form string="Select chemical substances for DNEL">
                <tree editable="bottom">
                    <field name="name" />
                </tree>
                <footer>
                    <button name="insert_dnel" string="Insert" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_wizard_dnel" model="ir.actions.act_window">
        <field name="name">Insert DNEL</field>
        <field name="type">ir.actions.act_window</field>
        <!-- <field name="res_model">sci.property.dnel.wizard</field> -->
        <field name="res_model">sds.chemical.substance</field>
        <field name="view_mode">tree</field>
        <field name="context">{'active_ids': active_ids}</field>
        <field name="target">new</field>
    </record>
</odoo>